rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && role() == 'admin';
    }

    function isDataOperator() {
      return isAuthenticated() && role() == 'data_operator';
    }

    function isBillViewer() {
      return isAuthenticated() && role() == 'bill_viewer';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Logins are provisioned by an Admin via the server-side API route
    // (firebase-admin, bypasses these rules). These rules are defense-in-depth
    // for any direct client reads/writes.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /pleaders/{pleaderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /feeConfig/{designation} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /boardEntries/{entryId} {
      allow read: if isAdmin() || isDataOperator() || isBillViewer();
      allow write: if isDataOperator();
    }
  }
}
