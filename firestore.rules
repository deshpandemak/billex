rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users  (doc ID = Firebase Auth UID)
//   uid: string, email: string, displayName: string, role: string,
//   active: bool, pleaderId: string|null, createdAt: timestamp,
//   createdBy: string, lastLoginAt: timestamp
//
// Collection: pleaders
//   name: string, designation: string, active: bool,
//   createdAt: timestamp, updatedAt: timestamp, createdBy: string
//
// Collection: feeConfig  (doc ID = designation)
//   designation: string, adjourned: number, heardAdjourned: number,
//   disposed: number, updatedAt: timestamp, updatedBy: string
//
// Collection: boardEntries
//   date: string (YYYY-MM-DD), caseType: string, caseNo: string,
//   year: string, petitioner: string, respondent: string, status: string,
//   pleaderId: string, pleaderName: string, designation: string,
//   fees: number, correctionRequested: string, correctionRequestedBy: string,
//   correctionRequestedAt: timestamp|null, billId: string|null,
//   billLocked: bool, createdAt: timestamp, updatedAt: timestamp,
//   createdBy: string, updatedBy: string
//
// Collection: bills
//   dateFrom: string, dateTo: string, pleaderId: string,
//   pleaderName: string, designation: string, status: string,
//   totalFees: number, entryCount: number, createdAt: timestamp,
//   createdBy: string, createdByName: string, submittedAt: timestamp|null,
//   finalizedAt: timestamp|null, finalizedBy: string|null,
//   finalizedByName: string|null
//
// Collection: auditLogs  (append-only)
//   action: string, entityType: string, entityId: string,
//   description: string, performedBy: string, performedByName: string,
//   performedByRole: string, timestamp: timestamp,
//   metadata: map
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function isAdmin() {
      return isAuthenticated() && role() == 'admin';
    }

    function isDataOperator() {
      return isAuthenticated() && role() == 'data_operator';
    }

    function isBillViewer() {
      return isAuthenticated() && role() == 'bill_viewer';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── users ───────────────────────────────────────────────────
    // Written by Admin-only API route (firebase-admin bypasses rules).
    // Users can read their own doc and update only lastLoginAt (set on login).
    // All other writes (role, active, pleaderId) are admin-only.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isOwner(userId) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['lastLoginAt']));
    }

    // ── pleaders ────────────────────────────────────────────────
    match /pleaders/{pleaderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── feeConfig ───────────────────────────────────────────────
    match /feeConfig/{designation} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── boardEntries ────────────────────────────────────────────
    // Data operators create/update/delete any field, for any pleader, at any
    // time (including entries already grouped into a bill).
    // Admins read all entries. Bill viewers may only read entries for the
    // pleader linked to their own login, and may additionally flag a
    // correction request on those entries — only those three fields
    // (fees, status, party names, etc. stay data-operator-only) — but only
    // while the bill that entry belongs to hasn't been submitted/finalized
    // yet (billLocked). Once a bill is submitted for billing, its entries
    // freeze and bill viewers can no longer add or change corrections.
    match /boardEntries/{entryId} {
      allow read: if isAdmin() || isDataOperator() ||
        (isBillViewer() && resource.data.pleaderId == userDoc().pleaderId);
      allow create: if isDataOperator();
      allow update: if isDataOperator() ||
        (isBillViewer() &&
         resource.data.pleaderId == userDoc().pleaderId &&
         resource.data.billLocked != true &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['correctionRequested', 'correctionRequestedBy', 'correctionRequestedAt']));
      allow delete: if isDataOperator();
    }

    // ── bills ───────────────────────────────────────────────────
    // Data operators generate bills and submit them for billing (finalize).
    // Bill viewers can only read bills assigned to their linked pleader —
    // never anyone else's — and have no write access; their review activity
    // (corrections) lives on the underlying boardEntries instead.
    // Admins can read all bills and finalize/manage them like data operators.
    match /bills/{billId} {
      allow read: if isAdmin() || isDataOperator() ||
        (isBillViewer() && resource.data.pleaderId == userDoc().pleaderId);

      allow create: if isDataOperator() || isAdmin();
      allow update: if isDataOperator() || isAdmin();
      allow delete: if false; // bills are never deleted
    }

    // ── auditLogs ───────────────────────────────────────────────
    // All authenticated users can append logs (client-side logging).
    // Only admins can read them.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.performedBy == request.auth.uid;
      allow update, delete: if false; // append-only
    }
  }
}
